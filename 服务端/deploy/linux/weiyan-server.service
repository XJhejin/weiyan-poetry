[Unit]
Description=Weiyan Poetry encrypted message relay
After=network.target

[Service]
Type=simple
User=weiyan
Group=weiyan
WorkingDirectory=/opt/weiyan/current/server
EnvironmentFile=/etc/weiyan/server.env
Environment=WEIYAN_DATA_DIR=/var/lib/weiyan
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/weiyan/current/venv/bin/python /opt/weiyan/current/server/server.py --browser --no-open --admin-port 23175 --admin-url-file /var/lib/weiyan/admin-url --host ${WEIYAN_HOST} --port ${WEIYAN_PORT}
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
