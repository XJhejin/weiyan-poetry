[Unit]
Description=Weiyan Poetry encrypted message relay
After=network.target

[Service]
Type=simple
User=weiyan
Group=weiyan
WorkingDirectory=/opt/weiyan/server
EnvironmentFile=/etc/weiyan/server.env
Environment=WEIYAN_DATA_DIR=/var/lib/weiyan
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/weiyan/venv/bin/python /opt/weiyan/server/server.py --headless --host ${WEIYAN_HOST} --port ${WEIYAN_PORT}
KillSignal=SIGINT
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
