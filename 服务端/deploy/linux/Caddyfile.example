{
    admin off
    auto_https disable_redirects
}

https://{$WEIYAN_PUBLIC_IP}:23074 {
    tls {
        issuer acme {
            dir https://acme-v02.api.letsencrypt.org/directory
            profile shortlived
            disable_tlsalpn_challenge
        }
    }
    request_body {
        max_size 48MB
    }
    reverse_proxy 127.0.0.1:23174
}
